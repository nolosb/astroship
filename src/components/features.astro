---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Development",
    description:
      "Each of our developers has multiple years of experience with the Discourse codebase and have published their own open source Discourse plugins and integrations. ",
    icon: "bx:bxs-terminal",
  },
  {
    title: "Design",
    description:
      "We provide expert design services, delivering custom themes and frontend components while adhering to Discourse best practices.",
    icon: "bx:bxs-pen",
  },
  {
    title: "Migration",
    description:
      "Our migration experts run their own Discourse hosting business and have performed migrations for thousands of communities, large and small.",
    icon: "bx:bxs-data",
  },
  { 
    title: "Integrations",
    description:
      "We implement a wide range of integrations with other services, including events, polls, and more.",
    icon: "bx:bxs-bot",
  },
  {
    title: "Community Management",
    description:
      "Our community management experts run their own highly active and thriving communities. Our management advice is backed by years of hands on experience.",
    icon: "bx:bxs-user",
  },
  {
    title: "Training",
    description:
      "We offer training for your team on how to use Discourse, including how to use the Discourse API and how to build plugins and integrations.",
    icon: "bx:bxs-book",
  },

];
---
<section id="section-solutions" class="pt-8 pb-12">
  <div class="mt-16 md:mt-0">
    <h2 class="text-4xl lg:text-5xl font-medium lg:tracking-tight">
      Everything you need to build with Discourse
    </h2>
    <p class="text-lg mt-4 text-slate-600">
      Our team of experts is ready to integrate with your organization. We bring
      deep expertise and tailored solutions to meet all your project needs.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
    {
      features.map((item) => (
        <div class="flex gap-4 items-start transition-all duration-300 hover:scale-105 hover:shadow-lg p-4 rounded-lg">
          <div class="mt-1 bg-indigo-700 rounded-full p-2 w-10 h-10 shrink-0 flex items-center justify-center">
            <Icon class="text-white w-5 h-5" name={item.icon} />
          </div>
          <div>
            <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
            <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
