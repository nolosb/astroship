---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Development",
    description:
      "Our developers have years of experience with the Discourse codebase and have built some of the most popular  plugins in the ecosystem.",
    icon: "bx:code-alt",
  },
  {
    title: "Design",
    description:
      "All our themes and components follow Discourse best practices, ensuring your designs will remain stable through ongoing updates.",
    icon: "bx:bxs-palette",
  },
  {
    title: "Migration",
    description:
      "We perform migrations from all major platforms as well as custom migrations. We have successfully migrated hundreds of communities, large and small.",
    icon: "bx:bxs-data",
  },
  { 
    title: "Integrations",
    description:
      "We implement a wide range of integrations with other services, including WordPress, events, polls, and more.",
    icon: "bx:bxs-cog",
  },
  {
  title: "AI",
    description:
      "We help you leverage AI for content moderation, conversation summaries, search capabilities, and personalized user experiences.",
    icon: "bx:bxs-bot",
  },
  {
    title: "Training",
    description:
      "We offer training for your team on how to use Discourse, including how to use the Discourse API and how to build plugins and integrations.",
    icon: "bx:bxs-book",
  },

];
---
<section id="section-solutions" class="pt-8 pb-12">
  <div class="mt-16 md:mt-0">
    <h2 class="text-4xl lg:text-5xl font-semibold text-slate-900 lg:tracking-tight">
      Everything you need to build with Discourse
    </h2>
    <p class="text-lg mt-4 text-slate-600">
      Our team of experts is ready to integrate with your organization. We bring
      deep expertise and tailored solutions to meet your project needs.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
    {
      features.map((item) => (
        <div class="flex gap-4 items-start transition-all duration-300 hover:scale-105 hover:shadow-lg p-4 rounded-lg">
          <div class="mt-1 bg-indigo-700 rounded-full p-2 w-10 h-10 shrink-0 flex items-center justify-center">
            <Icon class="text-white w-5 h-5" name={item.icon} />
          </div>
          <div>
            <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
            <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
