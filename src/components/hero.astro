---
import { Picture } from "astro:assets";
import heroImage from "assets/hero.png";
import Link from "@components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-20 pb-8 md:pt-24 md:pb-24">
  <div class="md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="Astronaut in the air"
      widths={[200, 400, 600, 800, 1000]}
      sizes="(max-width: 1000px) 100vw, 800px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-semibold lg:tracking-tight xl:tracking-tighter">
     Your Community Building Experts
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      Pavilion is a full-service agency specialized in Discourse, with expertise in
      development, design, operations, and community management.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        class="bg-indigo-700  flex gap-1 items-center justify-center"
        href="https://cal.com/team/pavilion"
        target="_blank"
        rel="noopener">
        <Icon class="text-white w-5 h-5" name="bx:bxs-comment" />
         Talk with Us
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="https://github.com/surjithctly/astroship"
        class="border-indigo-700  text-indigo-700 flex gap-1 items-center justify-center"
        target="_blank">
        <Icon class="text-indigo-700 w-4 h-4" name="bx:bx-chevrons-down" />
         Our Solutions
      </Link>
    </div>
  </div>
</main>
